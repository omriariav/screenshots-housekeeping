# Screenshot Renaming Tool Configuration
# Copy this file to .env and choose the provider you want to use.

# Provider: openai (cloud) or ollama (local)
LLM_PROVIDER=openai

# OpenAI configuration (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Ollama configuration (required only when LLM_PROVIDER=ollama)
# Start the service with: ollama serve
# Pull a vision-capable model first, for example: ollama pull qwen2.5vl:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Request settings
MAX_TOKENS=50
API_TIMEOUT=30
MAX_RETRIES=3

# Processing settings
# Maximum words in each description (minimum 2)
DESCRIPTION_LENGTH=5
BATCH_SIZE=5

# Optional: only rename screenshots with this filename prefix. Use when several Macs
# share one Desktop (e.g. via iCloud) so each Mac renames only its own screenshots.
# Set the matching macOS prefix with: defaults write com.apple.screencapture name "Work Screenshot"
# SCREENSHOT_PREFIX="Work Screenshot"

# Optional: override the default ~/Desktop folder
# DESKTOP_PATH=/Users/yourname/Desktop
